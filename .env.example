# Kopyalayıp .env yapın. .env asla commit edilmez.
ANTHROPIC_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=        # opsiyonel ama 429 hatalarını büyük ölçüde azaltır

# Model seçimi (paper-qa ve gpt-researcher LiteLLM/LangChain adlarını kullanır)
PQA_LLM=anthropic/claude-sonnet-5-5
PQA_SUMMARY_LLM=anthropic/claude-haiku-5-5
PQA_EMBEDDING=st-multi-qa-MiniLM-L6-cos-v1   # yerel, OpenAI anahtarı gerektirmez

# gpt-researcher
SMART_LLM=anthropic:claude-opus-5-5
FAST_LLM=anthropic:claude-haiku-5-5
STRATEGIC_LLM=anthropic:claude-opus-5-5
EMBEDDING=huggingface:sentence-transformers/all-MiniLM-L6-v2
RETRIEVER=semantic_scholar,pubmed_central,arxiv   # Tavily yerine akademik kaynaklar
